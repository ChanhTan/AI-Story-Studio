GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
THEME=dark
LANGUAGE=en
AUTO_SAVE=True

# Default image style (Anime, Cartoon, Cinematic, Realistic, Fantasy, Pixel Art, etc.)
DEFAULT_STYLE=Anime

# Default aspect ratio (16:9 or 9:16)
DEFAULT_ASPECT_RATIO=16:9

# Voice settings (used as default in gTTS)
EDGE_TTS_VOICE=en-US
EDGE_TTS_RATE=0%
EDGE_TTS_PITCH=0%
EDGE_TTS_VOLUME=0%

# TikTok TTS (optional - get sessionid from tiktok.com cookie)
TIKTOK_SESSION_ID=

# Performance
MAX_CONCURRENT_TABS=3
RETRY_COUNT=3

# Server
HOST=0.0.0.0
PORT=8000
